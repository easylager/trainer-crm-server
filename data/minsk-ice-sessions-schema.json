{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minsk-ice-sessions-v1",
  "title": "Minsk ice sessions spike export (maps to TASK-050 ice_sessions)",
  "description": "Read-only extraction from public rink pages. Not published to DB.",
  "type": "object",
  "required": ["schema_version", "generated_at", "timezone", "arenas"],
  "properties": {
    "schema_version": { "const": "1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "timezone": { "const": "Europe/Minsk" },
    "arenas": {
      "type": "array",
      "items": { "$ref": "#/$defs/arena" }
    }
  },
  "$defs": {
    "arena": {
      "type": "object",
      "required": ["arena_id", "arena_name", "extract_status", "sessions"],
      "properties": {
        "arena_id": { "type": "integer" },
        "arena_name": { "type": "string" },
        "source_urls": { "type": "array", "items": { "type": "string" } },
        "extractor": { "type": "string" },
        "extract_status": {
          "enum": ["ok", "partial", "failed", "skipped"]
        },
        "extract_notes": { "type": "string" },
        "price_catalog": {
          "type": "array",
          "items": { "$ref": "#/$defs/price_item" }
        },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" }
        }
      }
    },
    "price_item": {
      "type": "object",
      "required": ["label", "amount_minor", "currency_code"],
      "properties": {
        "label": { "type": "string" },
        "amount_minor": { "type": "integer" },
        "currency_code": { "type": "string" },
        "duration_minutes": { "type": ["integer", "null"] },
        "day_type": { "enum": ["weekday", "weekend", "any", null] }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "arena_id",
        "kind",
        "local_date",
        "starts_at_local",
        "starts_at_utc",
        "currency_code",
        "status",
        "confidence"
      ],
      "properties": {
        "arena_id": { "type": "integer" },
        "kind": {
          "enum": ["public_skate", "open_ice", "rental", "school_group", "event"]
        },
        "local_date": { "type": "string", "format": "date" },
        "starts_at_local": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "ends_at_local": { "type": ["string", "null"] },
        "starts_at_utc": { "type": "string", "format": "date-time" },
        "ends_at_utc": { "type": ["string", "null"] },
        "duration_minutes": { "type": ["integer", "null"] },
        "price_minor": { "type": ["integer", "null"] },
        "currency_code": { "type": "string" },
        "price_note": { "type": ["string", "null"] },
        "session_label": { "type": ["string", "null"] },
        "age_note": { "type": ["string", "null"] },
        "source_url": { "type": "string" },
        "status": { "enum": ["active", "cancelled", "superseded"] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    }
  }
}
