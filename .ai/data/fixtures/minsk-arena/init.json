3\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u0441\u0442\u0430\u0440\u0442\u044b:\u00a0\r\n\r\n\r\n\t\u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0435 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e \u0448\u043e\u0440\u0442-\u0442\u0440\u0435\u043a\u0443 Evo Cup (\u043e\u043a\u0442\u044f\u0431\u0440\u044c 2012 \u0433.)\r\n\t\u0413\u0440\u0430\u043d-\u043f\u0440\u0438 \u043f\u043e \u0444\u0438\u0433\u0443\u0440\u043d\u043e\u043c\u0443 \u043a\u0430\u0442\u0430\u043d\u0438\u044e \u043d\u0430 \u043a\u043e\u043d\u044c\u043a\u0430\u0445 \u0441\u0440\u0435\u0434\u0438 \u044e\u043d\u0438\u043e\u0440\u043e\u0432 (\u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044c 2013 \u0433.)\r\n\t\u044d\u0442\u0430\u043f\u044b \u041a\u0443\u0431\u043a\u0430 \u043c\u0438\u0440\u0430 \u043f\u043e \u043a\u043e\u043d\u044c\u043a\u043e\u0431\u0435\u0436\u043d\u043e\u043c\u0443 \u0441\u043f\u043e\u0440\u0442\u0443 \u0441\u0440\u0435\u0434\u0438 \u044e\u043d\u0438\u043e\u0440\u043e\u0432 (\u043d\u043e\u044f\u0431\u0440\u044c 2012 \u0433., \u0434\u0435\u043a\u0430\u0431\u0440\u044c 2014 \u0433.)\r\n\t\u0427\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 \u0415\u0432\u0440\u043e\u043f\u044b \u043f\u043e \u043a\u043e\u043d\u044c\u043a\u043e\u0431\u0435\u0436\u043d\u043e\u043c\u0443 \u0441\u043f\u043e\u0440\u0442\u0443 (\u044f\u043d\u0432\u0430\u0440\u044c 2016 \u0433.)\r\n\t\u044d\u0442\u0430\u043f\u044b \u041a\u0443\u0431\u043a\u0430 \u043c\u0438\u0440\u0430 \u043f\u043e \u043a\u043e\u043d\u044c\u043a\u043e\u0431\u0435\u0436\u043d\u043e\u043c\u0443 \u0441\u043f\u043e\u0440\u0442\u0443 \u0441\u0440\u0435\u0434\u0438 \u044e\u043d\u0438\u043e\u0440\u043e\u0432 (\u043d\u043e\u044f\u0431\u0440\u044c 2016 \u0433.)\r\n\t\u044d\u0442\u0430\u043f\u044b \u041a\u0443\u0431\u043a\u0430 \u041c\u0438\u0440\u0430 \u043f\u043e \u0448\u043e\u0440\u0442-\u0442\u0440\u0435\u043a\u0443 (\u0444\u0435\u0432\u0440\u0430\u043b\u044c 2017 \u0433.)\r\n\