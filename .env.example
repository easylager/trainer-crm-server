# Copy to .env and fill in secrets. Never commit .env (see .gitignore).
# Full reference: docs/ENVIRONMENT.md

# --- Telegram (required for bots) ---
TELEGRAM_BOT_TOKEN_CLIENT=
TELEGRAM_BOT_TOKEN_TRAINER=
# Optional: admin bot process (moderation Mini App)
# TELEGRAM_BOT_TOKEN_ADMIN=
# JSON array of Telegram user IDs (Pydantic list), e.g. [123456789]
# ADMIN_TELEGRAM_IDS=[123456789]
# Optional: one-time trainer link from site (dev stub)
# TRAINER_LINK_TOKEN=
# Temporary QA: skip getChat lookup that fills missing client telegram_username (test «Написать» via bot without @username).
# DISABLE_CLIENT_TELEGRAM_USERNAME_ENRICH=1
# QA: trainer mini-apps always open bot relay modal for «Написать клиенту» where relay is eligible
# (API GET /api/webapp/trainer/access exposes force_client_chat_relay — hub, расписание, клиенты, заявки).
# TRAINER_WEBAPP_FORCE_CLIENT_CHAT_RELAY=1
# QA/dev: в пушах по записи кнопка «Написать» открывает relay, если telegram клиента совпадает с тренером (один аккаунт для тестов).
# TRAINER_BOOKING_SELF_CLIENT_RELAY_BUTTON=1
# Multi-trainer studio/center overlay (collective API + «Студия» in shell). Keep off on prod until pilots.
# TRAINER_COLLECTIVE_ENABLED=0

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm
DATABASE_URL_SYNC=postgresql+psycopg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm

# --- S3-compatible storage (optional locally; use LOCAL_STORAGE_PATH for dev-only files) ---
# Prod: prefer non-public bucket + app keys with minimal IAM; see docs/ENVIRONMENT.md (S3).
S3_ENDPOINT=https://storage.railway.app
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PATH_STYLE=true
# LOCAL_STORAGE_PATH=./uploads

# --- Off-site Postgres backups (GitHub Actions → scripts/ops/backup_postgres.py) ---
# Separate bucket from app photos. Recommended: Cloudflare R2 or Backblaze B2 (~$0.05/mo).
# Docs: docs/ops/BACKUPS.md
# BACKUP_DATABASE_URL=postgresql://user:pass@host:5432/railway
# BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=ice-studio-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_PATH_STYLE=true
# BACKUP_RETENTION_DAYS=35
# Planned window: Mini Apps show «технические работы», /api returns 503. Unplanned DB outages are auto-detected.
# MAINTENANCE_MODE=false

# --- Group cohort RSVP (client bot; notification_service) ---
# За сколько часов до слота спрашивать «Буду» / «Не смогу». Без переменной или 0 — выключено.
# GROUP_ATTENDANCE_PROMPT_HOURS=24

# Recurring «постоянный клиент»: горизонт автозаписей (недель) и интервал досоздания в notification_service.
# RECURRING_MATERIALIZATION_HORIZON_WEEKS=3
# RECURRING_VIRTUAL_PREVIEW_WEEKS=8
# RECURRING_MATERIALIZATION_LOOP_INTERVAL_SEC=21600

# --- notification_service: интервалы «суточных» циклов (секунды). По умолчанию 86400 (1 сутки). Для локальной отладки trial/expiry/recovery можно 10–60; в проде оставьте 86400.
# NOTIFICATION_SUBSCRIPTION_LOOP_INTERVAL_SEC=86400
# NOTIFICATION_LEAD_MODE_RECOVERY_INTERVAL_SEC=86400
# Тихие часы 08:00–22:00 Europe/Minsk отключить для тестов пушей:
# NOTIFICATION_DISABLE_QUIET_HOURS=true

# --- notification_service: авто-«проведено» после end_time слота (секунды, 15–600) ---
# BOOKING_COMPLETE_POLL_INTERVAL_SEC=60
# Тайминг пуша тренеру «подходит к концу» задан в коде: src.shared.config TRAINER_SESSION_WRAPUP_* (не .env).

# --- App URLs (production: HTTPS) ---
API_BASE_URL=http://localhost:8000
# Mini App URLs; for trainer bot «Обзор» menu button Telegram needs HTTPS — use WEBAPP_BASE_URL=https://...
# If WEBAPP_BASE_URL stays http://localhost, the bot falls back to API_BASE_URL when that is HTTPS.
WEBAPP_BASE_URL=http://localhost:8000
# PHOTO_BASE_URL=
# PHOTO_CDN_BASE_URL=https://cdn.yourdomain.com
PHOTO_PRESIGNED_EXPIRES_SEC=3600
# PHOTO_UPLOAD_PRESIGN_EXPIRES_SEC=600
# Legacy curl upload to /api/upload/* (disabled in prod if unset):
# INTERNAL_UPLOAD_API_KEY=

# --- Sentry (optional; errors from API + bot processes) ---
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=trainer-crm@1.0.0+git
# Optional: shown in admin bot /version (else SENTRY_RELEASE or «не задано»)
# APP_DEPLOY_VERSION=${RAILWAY_GIT_COMMIT_SHA}
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_PROFILES_SAMPLE_RATE=0

# --- Booking «Client problem» (PRD E7 rollout) ---
# BOOKING_PROBLEM_ROLLOUT=full
# off | pilot | full — при pilot задайте JSON-массив internal trainer_id:
# BOOKING_PROBLEM_PILOT_TRAINER_IDS=[1, 2]

# --- Runtime ---
# DEBUG=false in production: also disables /docs, /redoc, /openapi.json
DEBUG=false
# Legacy REST /api/trainers/* (no initData) — dev/tests only; omit or 0 in production
# LEGACY_TRAINERS_API_ENABLED=0
# Client booking anti-spam (POST /api/webapp/client/booking)
# CLIENT_BOOKING_RATE_MAX_REQUESTS=8
# CLIENT_BOOKING_RATE_WINDOW_SEC=600
# CLIENT_BOOKING_MAX_PENDING_PER_TRAINER=3
# CLIENT_BOOKING_MAX_PENDING_GLOBAL=8
LOG_LEVEL=INFO
# Mini App initData: max age of auth_date (seconds), clock skew for future timestamps
# TELEGRAM_WEBAPP_INIT_DATA_MAX_AGE_SEC=86400
# TELEGRAM_WEBAPP_INIT_DATA_CLOCK_SKEW_SEC=300
AUDIT_LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60
SCHEDULE_REMINDER_COOLDOWN_MINUTES=180

# --- HTTP API (rate limit per IP on /api/* except webhooks; body cap when Content-Length set) ---
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
# API_RATE_LIMIT_WEBAPP_MAX_REQUESTS=800
# API_MAX_BODY_BYTES_DEFAULT=1048576
# API_MAX_BODY_BYTES_UPLOAD=26214400

# --- Payments (bePaid) ---
# BEPAID_SHOP_ID=
# BEPAID_SECRET_KEY=
BEPAID_CHECKOUT_BASE_URL=https://checkout.bepaid.by
PAYMENT_SANDBOX=true
# Trainer Mini App «Подписка»: auto | sandbox | bepaid | invoice
# auto: sandbox if PAYMENT_SANDBOX=true; elif BEPAID_* set then bepaid; else invoice (счёт / ЕРИП, подтверждение вручную).
# TRAINER_SUBSCRIPTION_CHECKOUT_MODE=invoice
# SUBSCRIPTION_INVOICE_LEGAL_NAME=
# SUBSCRIPTION_INVOICE_UNP=
# SUBSCRIPTION_INVOICE_IBAN=
# SUBSCRIPTION_INVOICE_BANK_HINT_RU=
# SUBSCRIPTION_INVOICE_EXTRA_HINT_RU=
# SUBSCRIPTION_SUPPORT_URL=https://t.me/your_support

# --- Subscriptions / certificates ---
# TRIAL_PERIOD_DAYS=
# Платные подписки: классический биллинг-ремайндер за N дней до окончания (по умолчанию 3).
SUBSCRIPTION_REMINDER_DAYS_AHEAD=3
# Trial conversion cadence (D-2 → D-1 → D+0):
# • D-2 — ROI recap (mental anchoring, без CTA). По умолчанию 2.
# • D-1 — loss reminder (decision + что встанет на паузу). По умолчанию 1.
# • D+0 — graceful downgrade приходит из Lead Mode recovery (D+0 / D+3 / D+14 / D+30).
# TRIAL_ROI_RECAP_DAYS_AHEAD=2
# SUBSCRIPTION_REMINDER_TRIAL_DAYS_AHEAD=1
# NOTIFY_TELEGRAM_ID=

# --- SMTP (certificate emails; omit any to disable sending) ---
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# CLIENT_BOT_USERNAME=YourClientBot
# TRAINER_BOT_USERNAME=YourTrainerBot

# --- Glide public landing (GET /) ---
# LANDING_VERTICAL=ice
# LANDING_MARKET=by
# LANDING_TRAINER_REGISTRATION_ENABLED=1
# LANDING_TRAINER_START_MAX_REQUESTS=3
# LANDING_TRAINER_START_WINDOW_SEC=600

# --- Tooling (Cursor MCP; not app secrets) ---
# Cursor MCP (@modelcontextprotocol/server-postgres): plain postgresql:// URL
POSTGRES_MCP_URL=postgresql://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm
# GITHUB_PERSONAL_ACCESS_TOKEN=
# NOTION_TOKEN=
