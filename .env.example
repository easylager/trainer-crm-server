# Telegram: two bots (separate processes)
TELEGRAM_BOT_TOKEN_CLIENT=
TELEGRAM_BOT_TOKEN_TRAINER=
# Optional: trainer link token from site (dev stub; later from DB). t.me/trainer_bot?start=link_<token>
# TRAINER_LINK_TOKEN=secret123

# Database (must match docker-compose: user trainer_crm, password trainer_crm_dev)
DATABASE_URL=postgresql+asyncpg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm
DATABASE_URL_SYNC=postgresql+psycopg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm

# Storage: Railway Buckets (S3-compatible). From Railway → Bucket → Credentials.
S3_ENDPOINT=https://storage.railway.app
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PATH_STYLE=true

# Payment (when integrated)
# ERIP_ID=
# STRIPE_SECRET_KEY=

# App
DEBUG=false
LOG_LEVEL=INFO
