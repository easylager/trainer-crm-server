# Copy to .env and fill in secrets. Never commit .env (see .gitignore).
# Full reference: docs/ENVIRONMENT.md

# --- Telegram (required for bots) ---
TELEGRAM_BOT_TOKEN_CLIENT=
TELEGRAM_BOT_TOKEN_TRAINER=
# Optional: admin bot process (moderation Mini App)
# TELEGRAM_BOT_TOKEN_ADMIN=
# JSON array of Telegram user IDs (Pydantic list), e.g. [123456789]
# ADMIN_TELEGRAM_IDS=[123456789]
# Optional: one-time trainer link from site (dev stub)
# TRAINER_LINK_TOKEN=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm
DATABASE_URL_SYNC=postgresql+psycopg://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm

# --- S3-compatible storage (optional locally; use LOCAL_STORAGE_PATH for dev-only files) ---
# Prod: prefer non-public bucket + app keys with minimal IAM; see docs/ENVIRONMENT.md (S3).
S3_ENDPOINT=https://storage.railway.app
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PATH_STYLE=true
# LOCAL_STORAGE_PATH=./uploads

# --- App URLs (production: HTTPS) ---
API_BASE_URL=http://localhost:8000
WEBAPP_BASE_URL=http://localhost:8000
# PHOTO_BASE_URL=
# PHOTO_CDN_BASE_URL=https://cdn.yourdomain.com
PHOTO_PRESIGNED_EXPIRES_SEC=3600
# PHOTO_UPLOAD_PRESIGN_EXPIRES_SEC=600
# Legacy curl upload to /api/upload/* (disabled in prod if unset):
# INTERNAL_UPLOAD_API_KEY=

# --- Runtime ---
DEBUG=false
LOG_LEVEL=INFO
# Mini App initData: max age of auth_date (seconds), clock skew for future timestamps
# TELEGRAM_WEBAPP_INIT_DATA_MAX_AGE_SEC=86400
# TELEGRAM_WEBAPP_INIT_DATA_CLOCK_SKEW_SEC=300
AUDIT_LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60
SCHEDULE_REMINDER_COOLDOWN_MINUTES=180

# --- HTTP API (rate limit per IP on /api/* except webhooks; body cap when Content-Length set) ---
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
# API_RATE_LIMIT_WEBAPP_MAX_REQUESTS=800
# API_MAX_BODY_BYTES_DEFAULT=1048576
# API_MAX_BODY_BYTES_UPLOAD=26214400

# --- Payments (bePaid) ---
# BEPAID_SHOP_ID=
# BEPAID_SECRET_KEY=
BEPAID_CHECKOUT_BASE_URL=https://checkout.bepaid.by
PAYMENT_SANDBOX=true

# --- Subscriptions / certificates ---
# TRIAL_PERIOD_DAYS=
SUBSCRIPTION_REMINDER_DAYS_AHEAD=3
# NOTIFY_TELEGRAM_ID=

# --- SMTP (certificate emails; omit any to disable sending) ---
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# CLIENT_BOT_USERNAME=YourClientBot

# --- Tooling (Cursor MCP; not app secrets) ---
# Cursor MCP (@modelcontextprotocol/server-postgres): plain postgresql:// URL
POSTGRES_MCP_URL=postgresql://trainer_crm:trainer_crm_dev@localhost:5432/trainer_crm
# GITHUB_PERSONAL_ACCESS_TOKEN=
# NOTION_TOKEN=
